# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env
# .env 不会被提交到 git，git pull 升级时也不会被覆盖。

# 首次启动时创建的管理员（用户名 admin）密码，至少 10 位。
# 留空则随机生成一个，打印在容器日志里。启动后可在网页「设置」里改密码，这里就不再起作用。
LIULI_ADMIN_PASSWORD=

# 忘记密码时：把上面改成新密码、这里改成 1，重建容器后登录，再改回 0
LIULI_RESET_PASSWORD=0

# 网站日志目录（宿主机路径），里面是 <域名>/log/access.log。1Panel 2.x 默认就是这个
LIULI_LOGS_DIR=/opt/1panel/www/sites

# 首次启动时导入的站点（可不填：默认会自动发现日志目录下的所有站点）
# 格式：域名=容器内日志路径，多个用分号隔开，例如
# LIULI_SITES=example.com=/logs/example.com/log/access.log
LIULI_SITES=

# 观测台监听的本机端口（只绑 127.0.0.1，由反代转发）
LIULI_PORT=8090

# 登录 Cookie 只走 HTTPS。暂时用 http 访问调试时改成 0，调试完改回 1
LIULI_COOKIE_SECURE=1

TZ=Asia/Shanghai

# ---------------- 封禁 IP（可选，见部署说明「封禁 IP」一节） ----------------

# 规则目录（宿主机路径）。要在 OpenResty 能看到的位置：1Panel 把 /opt/1panel/www 挂进 OpenResty 的 /www
LIULI_BAN_HOST_DIR=/opt/1panel/www/liuli-ban
# OpenResty 容器里看到的规则文件路径（和上面对应）
LIULI_BAN_INCLUDE=/www/liuli-ban/deny.conf

# 1Panel API：用来在封禁 / 解封后平滑重载 OpenResty。不填则只写规则文件，需要手动重载
# 地址：从观测台容器访问 1Panel，用 1panel-network 的网关地址 + 面板端口，例如 https://172.18.0.1:39541
LIULI_1PANEL_URL=
# 在 1Panel「面板设置 → API 接口」新建一个专用密钥，IP 白名单只填下面 LIULI_IPV4 的地址
LIULI_1PANEL_API_KEY=
# 1Panel 有多个 API 密钥时可填密钥 ID，只有一个可以不填
LIULI_1PANEL_KEY_ID=

# 观测台在 1panel-network 里的固定 IP（给 1Panel API 白名单用）。留空则自动分配
# 选一个不会和其他容器冲突的地址，例如 172.18.250.10（要在 1panel-network 的子网内）
LIULI_IPV4=
