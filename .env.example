# 复制为 .env 后修改：cp .env.example .env
# .env 不会被提交到 git，git pull 升级时也不会被覆盖。

# 首次启动时创建的管理员（用户名 admin）密码，至少 10 位。
# 留空则随机生成一个，打印在容器日志里。启动后可在网页「设置」里改密码，这里就不再起作用。
LIULI_ADMIN_PASSWORD=

# 忘记密码时：把上面改成新密码、这里改成 1，重建容器后登录，再改回 0
LIULI_RESET_PASSWORD=0

# 网站日志目录（宿主机路径），里面是 <域名>/log/access.log。1Panel 2.x 默认就是这个
LIULI_LOGS_DIR=/opt/1panel/www/sites

# 首次启动时导入的站点（可不填：默认会自动发现日志目录下的所有站点）
# 格式：域名=容器内日志路径，多个用分号隔开，例如
# LIULI_SITES=example.com=/logs/example.com/log/access.log
LIULI_SITES=

# 观测台监听的本机端口（只绑 127.0.0.1，由反代转发）
LIULI_PORT=8090

# 登录 Cookie 只走 HTTPS。暂时用 http 访问调试时改成 0，调试完改回 1
LIULI_COOKIE_SECURE=1

TZ=Asia/Shanghai
